generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int              @id @default(autoincrement())
  email           String           @unique
  passwordHash    String           @map("password_hash")
  role            Role
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  auditLogs       AuditLog[]
  fitnessPlans    FitnessPlan[]
  footballAthlete FootballAthlete?
  medicalRecords  MedicalRecord[]  @relation("MedicRecords")
  notifications   Notification[]
  profile         Profile?
  tennisAthlete   TennisAthlete?
  trainingPlans   TrainingPlan[]

  @@map("users")
}

model Team {
  id          Int             @id @default(autoincrement())
  name        String
  sport       Sport
  country     String
  continent   String
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  awayMatches FootballMatch[] @relation("AwayTeam")
  homeMatches FootballMatch[] @relation("HomeTeam")
  profiles    Profile[]

  @@map("teams")
}

model Competition {
  id              Int             @id @default(autoincrement())
  name            String
  sport           Sport
  country         String
  continent       String
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  footballMatches FootballMatch[]
  tennisMatches   TennisMatch[]

  @@map("competitions")
}

model Profile {
  id               Int         @id @default(autoincrement())
  userId           Int         @unique @map("user_id")
  firstName        String      @map("first_name")
  lastName         String      @map("last_name")
  dateOfBirth      DateTime?   @map("date_of_birth")
  nationality      String?
  phone            String?
  profilePicture   String?     @map("profile_picture")
  teamId           Int?        @map("team_id")
  gender           Gender?
  maxHeartRate     Int?        @map("max_heart_rate")
  restingHeartRate Int?        @map("resting_heart_rate")
  activities       Activity[]
  dailyLoads       DailyLoad[]
  team             Team?       @relation(fields: [teamId], references: [id])
  user             User        @relation(fields: [userId], references: [id])

  @@map("profiles")
}

model FootballAthlete {
  id              Int              @id @default(autoincrement())
  userId          Int              @unique @map("user_id")
  position        Position
  jerseyNumber    Int?             @map("jersey_number")
  heightCm        Float?           @map("height_cm")
  weightKg        Float?           @map("weight_kg")
  preferredFoot   PreferredFoot    @map("preferred_foot")
  contractUntil   DateTime?        @map("contract_until")
  fitnessSessions FitnessSession[]
  user            User             @relation(fields: [userId], references: [id])
  stats           FootballStat[]
  medicalRecords  MedicalRecord[]

  @@map("football_athletes")
}

model TennisAthlete {
  id            Int           @id @default(autoincrement())
  userId        Int           @unique @map("user_id")
  heightCm      Float?        @map("height_cm")
  weightKg      Float?        @map("weight_kg")
  preferredHand PreferredHand @map("preferred_hand")
  playingStyle  PlayingStyle  @map("playing_style")
  atpWtaRanking Int?          @map("atp_wta_ranking")
  contractUntil DateTime?     @map("contract_until")
  user          User          @relation(fields: [userId], references: [id])
  matches       TennisMatch[]
  stats         TennisStat[]

  @@map("tennis_athletes")
}

model FootballStat {
  id              Int             @id @default(autoincrement())
  athleteId       Int             @map("athlete_id")
  matchId         Int             @map("match_id")
  goals           Int             @default(0)
  assists         Int             @default(0)
  minutesPlayed   Int             @default(0) @map("minutes_played")
  yellowCards     Int             @default(0) @map("yellow_cards")
  redCards        Int             @default(0) @map("red_cards")
  shotsOnTarget   Int             @default(0) @map("shots_on_target")
  passesCompleted Int             @default(0) @map("passes_completed")
  kmRan           Float           @default(0) @map("km_ran")
  rating          Float?
  athlete         FootballAthlete @relation(fields: [athleteId], references: [id])
  match           FootballMatch   @relation(fields: [matchId], references: [id])

  @@map("football_stats")
}

model TennisStat {
  id                   Int           @id @default(autoincrement())
  athleteId            Int           @map("athlete_id")
  matchId              Int           @map("match_id")
  aces                 Int           @default(0)
  doubleFaults         Int           @default(0) @map("double_faults")
  firstServePercentage Float         @default(0) @map("first_serve_percentage")
  breakPointsSaved     Int           @default(0) @map("break_points_saved")
  winners              Int           @default(0)
  unforcedErrors       Int           @default(0) @map("unforced_errors")
  setsWon              Int           @default(0) @map("sets_won")
  athlete              TennisAthlete @relation(fields: [athleteId], references: [id])
  match                TennisMatch   @relation(fields: [matchId], references: [id])

  @@map("tennis_stats")
}

model FootballMatch {
  id            Int            @id @default(autoincrement())
  teamHomeId    Int            @map("team_home_id")
  teamAwayId    Int            @map("team_away_id")
  matchDate     DateTime       @map("match_date")
  location      String
  scoreHome     Int?           @map("score_home")
  scoreAway     Int?           @map("score_away")
  competitionId Int            @map("competition_id")
  competition   Competition    @relation(fields: [competitionId], references: [id])
  teamAway      Team           @relation("AwayTeam", fields: [teamAwayId], references: [id])
  teamHome      Team           @relation("HomeTeam", fields: [teamHomeId], references: [id])
  stats         FootballStat[]

  @@map("football_matches")
}

model TennisMatch {
  id            Int           @id @default(autoincrement())
  athleteId     Int           @map("athlete_id")
  opponentName  String        @map("opponent_name")
  matchDate     DateTime      @map("match_date")
  location      String
  surface       Surface
  result        MatchResult
  competitionId Int           @map("competition_id")
  athlete       TennisAthlete @relation(fields: [athleteId], references: [id])
  competition   Competition   @relation(fields: [competitionId], references: [id])
  stats         TennisStat[]

  @@map("tennis_matches")
}

model MedicalRecord {
  id          Int             @id @default(autoincrement())
  athleteId   Int             @map("athlete_id")
  medicId     Int             @map("medic_id")
  diagnosis   String
  treatment   String
  startDate   DateTime        @map("start_date")
  endDate     DateTime?       @map("end_date")
  isAvailable Boolean         @default(true) @map("is_available")
  createdAt   DateTime        @default(now()) @map("created_at")
  injuries    Injury[]
  athlete     FootballAthlete @relation(fields: [athleteId], references: [id])
  medic       User            @relation("MedicRecords", fields: [medicId], references: [id])

  @@map("medical_records")
}

model Injury {
  id              Int           @id @default(autoincrement())
  medicalRecordId Int           @map("medical_record_id")
  injuryType      String        @map("injury_type")
  bodyPart        String        @map("body_part")
  severity        Severity
  recoveryDays    Int           @map("recovery_days")
  notes           String?
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id])

  @@map("injuries")
}

model TrainingPlan {
  id              Int              @id @default(autoincrement())
  createdBy       Int              @map("created_by")
  title           String
  description     String?
  type            TrainingType
  date            DateTime
  createdAt       DateTime         @default(now()) @map("created_at")
  fitnessSessions FitnessSession[]
  creator         User             @relation(fields: [createdBy], references: [id])

  @@map("training_plans")
}

model FitnessPlan {
  id          Int         @id @default(autoincrement())
  createdBy   Int         @map("created_by")
  title       String
  description String?
  type        FitnessType
  date        DateTime
  createdAt   DateTime    @default(now()) @map("created_at")
  creator     User        @relation(fields: [createdBy], references: [id])

  @@map("fitness_plans")
}

model FitnessSession {
  id              Int             @id @default(autoincrement())
  athleteId       Int             @map("athlete_id")
  trainingPlanId  Int             @map("training_plan_id")
  date            DateTime
  durationMinutes Int             @map("duration_minutes")
  heartRateAvg    Int?            @map("heart_rate_avg")
  caloriesBurned  Int?            @map("calories_burned")
  notes           String?
  athlete         FootballAthlete @relation(fields: [athleteId], references: [id])
  trainingPlan    TrainingPlan    @relation(fields: [trainingPlanId], references: [id])

  @@map("fitness_sessions")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model AuditLog {
  id            Int         @id @default(autoincrement())
  userId        Int         @map("user_id")
  action        AuditAction
  tableAffected String      @map("table_affected")
  recordId      Int?        @map("record_id")
  details       Json?
  createdAt     DateTime    @default(now()) @map("created_at")
  user          User        @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

/// O sesiune de antrenament - sursa primara pentru calculul TRIMP.
/// Nu se insereaza manual in DailyLoad; pipeline-ul de calcul
/// reagregeaza automat dupa fiecare upsert in Activity.
model Activity {
  id           Int      @id @default(autoincrement())
  athleteId    Int      @map("athlete_id")
  date         DateTime
  durationMin  Float    @map("duration_min")
  avgHeartRate Float?   @map("avg_heart_rate")
  sport        String?
  notes        String?
  trimp        Float?
  athlete      Profile  @relation(fields: [athleteId], references: [id])

  @@index([athleteId, date])
  @@map("activities")
}

/// Agregare zilnica per atlet - se populeaza exclusiv prin pipeline,
/// niciodata manual. @@unique garanteaza un singur rand per atlet/zi.
model DailyLoad {
  id        Int      @id @default(autoincrement())
  athleteId Int      @map("athlete_id")
  date      DateTime @db.Date
  trimp     Float
  atl       Float
  ctl       Float
  tsb       Float
  acRatio   Float    @map("ac_ratio")
  monotony  Float?
  strain    Float?
  athlete   Profile  @relation(fields: [athleteId], references: [id])

  @@unique([athleteId, date])
  @@index([athleteId])
  @@map("daily_loads")
}

enum Role {
  admin_global
  manager_fotbal
  manager_tenis
  antrenor_fotbal
  antrenor_fitness
  medic
  atlet_fotbal
  atlet_tenis
}

enum Sport {
  fotbal
  tenis
}

enum Position {
  portar
  fundas
  mijlocas
  atacant
}

enum PreferredFoot {
  stanga
  dreapta
  ambele
}

enum PreferredHand {
  stanga
  dreapta
}

enum PlayingStyle {
  baseline
  serve_volley
  all_court
}

enum Surface {
  zgura
  iarba
  hard
}

enum MatchResult {
  victorie
  infrangere
}

enum Severity {
  usoara
  medie
  grava
}

enum TrainingType {
  tehnic
  fizic
  tactic
}

enum FitnessType {
  forta
  rezistenta
  vitezare
  flexibilitate
  coordonare
}

enum AuditAction {
  create
  update
  delete
  login
  logout
}

enum Gender {
  MALE
  FEMALE
}
